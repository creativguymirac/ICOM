# ============================================
# CONFIGURATION EMAIL (OBLIGATOIRE)
# ============================================
# 1. Activer 2FA sur votre compte Gmail: https://accounts.google.com/
# 2. Créer un App Password: https://myaccount.google.com/apppasswords
# 3. Sélectionner "Mail" et votre OS
# 4. Copier le mot de passe généré (16 caractères)

EMAIL_USER=votre-email@gmail.com
EMAIL_PASSWORD=votre-app-password-16-caracteres

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=production

# ============================================
# CORS - URL de votre frontend
# ============================================
FRONTEND_URL=https://votredomaine.com,http://localhost:3000

# ============================================
# SÉCURITÉ (optionnel)
# ============================================
CLIENT_SECRET=changez-moi-en-production
